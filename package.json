{
  "name": "bxy-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @bxy/web dev",
    "dev:video": "pnpm --filter @bxy/video-engine studio",
    "build:web": "pnpm --filter @bxy/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "create-client": "bash scripts/create-client.sh"
  }
}
